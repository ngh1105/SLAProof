# Toggle: "mock" (default, offline) or "genlayer" (live Studionet)
NEXT_PUBLIC_SLAPROOF_VERIFIER=mock

# GenLayer Studionet config — required when verifier=genlayer
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio.genlayer.com/api
NEXT_PUBLIC_SLAPROOF_NETWORK_LABEL=Studionet
NEXT_PUBLIC_SLAPROOF_CONTRACT_ADDRESS=0x419D67e92855B94C0BF997638963961CA0A5dBC9
NEXT_PUBLIC_SLAPROOF_CHAIN_ID=61999

# Optional: pilot auth token. When set, all routes require login at /login.
# PILOT_TOKEN=

# Optional: server-side demo signer for `npm run smoke:genlayer:write` only.
# Never commit. Used only by CLI smoke, never read by the browser.
# GENLAYER_PRIVATE_KEY=0x...

# Optional: remote error sink. When set, reportError() also POSTs a JSON
# payload to this URL (Sentry envelope, Datadog Events, Slack webhook, ...).
# Falls back to logger-only when unset.
# ERROR_WEBHOOK_URL=
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=
# SLAPROOF_RELEASE=

# --- Managed database (optional) ---
# Store backend: "file" (default, pilot) or "postgres" (managed DB).
SLAPROOF_STORE=file
# Required when SLAPROOF_STORE=postgres. Hosted Postgres (Neon/Supabase) or self-host.
# DATABASE_URL=postgres://user:password@host:5432/dbname
# Used only by the env-guarded Postgres integration test:
# TEST_DATABASE_URL=postgres://user:password@host:5432/dbname_test
